<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CustomerSupport_CustomerDesktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CustomerSupport_CustomerDesktop"
    xmlns:models="using:CustomerSupport_CustomerDesktop.Models"
    xmlns:dtos="using:CustomerSupport.Application.Dtos"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
        <local:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <local:NullToVisibilityConverter x:Key="NotNullToVis" Invert="False" />
        <local:NullToVisibilityConverter x:Key="NullToVis" Invert="True" />
        <local:StringNotNullOrEmptyToBoolConverter x:Key="StringNotEmptyToBool" />
        <local:ChatSenderToAlignmentConverter x:Key="SenderToAlignment" />
        <local:ChatSenderToBackgroundConverter x:Key="SenderToBackground" />
        <local:ChatSenderToForegroundConverter x:Key="SenderToForeground" />
        <local:ChatSenderToCornerRadiusConverter x:Key="SenderToCornerRadius" />
        <local:IsMineToAlignmentConverter x:Key="IsMineToAlignment" />
        <local:IsMineToBackgroundConverter x:Key="IsMineToBackground" />
        <local:IsMineToForegroundConverter x:Key="IsMineToForeground" />
        <local:IsMineToCornerRadiusConverter x:Key="IsMineToCornerRadius" />
        <local:StringToImageSourceConverter x:Key="StringToImageSource" />
    </Page.Resources>

    <Grid Padding="24,16,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <!-- 0: Header Banner & User Profile -->
            <RowDefinition Height="Auto" />
            <!-- 1: Notification / Progress Bar -->
            <RowDefinition Height="Auto" />
            <!-- 2: Main Workspace (Master List + Chat/Details) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ROW 0: Header Banner & User Profile -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Hamburger Sidebar Toggle Button -->
            <Button Grid.Column="0"
                    Command="{x:Bind ViewModel.ToggleSidebarCommand}"
                    ToolTipService.ToolTip="Toggle Tickets Panel"
                    VerticalAlignment="Center"
                    Padding="8"
                    CornerRadius="6"
                    Background="Transparent"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <FontIcon Glyph="&#xE700;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" />
            </Button>

            <!-- App Title & Branding -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="Customer Support Portal"
                           Style="{StaticResource TitleLargeTextBlockStyle}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="Conversational IT &amp; Hospital Systems Support Desk"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- User Profile & Action Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                <!-- User Profile Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <PersonPicture DisplayName="{x:Bind ViewModel.CurrentUserDisplayName, Mode=OneWay}" Width="32" Height="32" />
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{x:Bind ViewModel.CurrentUserDisplayName, Mode=OneWay}"
                                       FontWeight="Medium"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentUserDepartment, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Refresh Button -->
                <Button Command="{x:Bind ViewModel.RefreshRequestsCommand}"
                        ToolTipService.ToolTip="Refresh My Complaints">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Refresh" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>

                <!-- Start Support Chat Button -->
                <Button Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.StartNewChatCommand}"
                        ToolTipService.ToolTip="Start a new chat to report an issue">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8BD;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                        <TextBlock Text="New Support Chat" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <!-- Sign Out Button -->
                <Button Command="{x:Bind ViewModel.SignOutCommand}"
                        ToolTipService.ToolTip="Sign out of current account">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7E8;" FontSize="14" />
                        <TextBlock Text="Sign Out" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ROW 1: Progress & Status Banner -->
        <StackPanel Grid.Row="1" Spacing="8">
            <ProgressBar IsIndeterminate="True"
                         Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                         HorizontalAlignment="Stretch" />

            <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Converter={StaticResource StringNotEmptyToBool}, Mode=OneWay}"
                     Severity="Error"
                     Title="Error"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
        </StackPanel>

        <!-- ROW 2: Master-Detail Work Area (SplitView with Sliding Drawer) -->
        <SplitView Grid.Row="2"
                   IsPaneOpen="{x:Bind ViewModel.IsSidebarOpen, Mode=TwoWay}"
                   DisplayMode="Inline"
                   OpenPaneLength="380"
                   CompactPaneLength="0"
                   PaneBackground="Transparent">
            <!-- PANE: Tickets List (Master) -->
            <SplitView.Pane>
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,16,0">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="4">
                            <TextBlock Text="My Support Tickets"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Click any ticket to view details or history"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <!-- Tickets ListView -->
                        <ListView Grid.Row="1"
                                  ItemsSource="{x:Bind ViewModel.Requests, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedRequest, Mode=TwoWay}"
                                  IsItemClickEnabled="True"
                                  ItemClick="TicketsListView_ItemClick"
                                  SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="dtos:SupportRequestDto">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12"
                                            Margin="0,0,0,8"
                                            HorizontalAlignment="Stretch">
                                        <Grid RowSpacing="6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Subject & Unread Count Badge (WhatsApp style) -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Bind DepartmentTitle}"
                                                           FontWeight="SemiBold"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="1"
                                                           VerticalAlignment="Center" />

                                                <Border Grid.Column="1"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="10"
                                                        MinWidth="20"
                                                        Height="20"
                                                        Padding="6,1"
                                                        Margin="6,0,0,0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Visibility="{x:Bind HasUnreadMessages, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{x:Bind UnreadCount, Mode=OneWay}"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>

                                            <!-- Snippet -->
                                            <TextBlock Grid.Row="1"
                                                       Text="{x:Bind SummaryText}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="2" />

                                            <!-- Badges: Status & Priority -->
                                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                                <Border Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                                                        CornerRadius="4"
                                                        Padding="6,2">
                                                    <TextBlock Text="{x:Bind StatusName}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               FontWeight="SemiBold" />
                                                </Border>

                                                <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                        CornerRadius="4"
                                                        Padding="6,2">
                                                    <TextBlock Text="{x:Bind PriorityName}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               FontWeight="Medium" />
                                                </Border>

                                                <TextBlock Text="{x:Bind CreatedAtFormatted}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </SplitView.Pane>

            <!-- RIGHT COLUMN: Dynamic Area (Chatbot OR Ticket Details) -->
            <SplitView.Content>
                <Border
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <Grid>
                    <!-- VIEW 1: Conversational Unified Chat View (Active when IsChatMode is true) -->
                    <Grid Visibility="{x:Bind ViewModel.IsChatMode, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                          RowSpacing="14">
                        <Grid.RowDefinitions>
                            <!-- Header (Bot intake header or Active Ticket header) -->
                            <RowDefinition Height="Auto" />
                            <!-- Chat Message Stream -->
                            <RowDefinition Height="*" />
                            <!-- Typing Indicator -->
                            <RowDefinition Height="Auto" />
                            <!-- Chat Input Bar -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Chat Header: Virtual Assistant Mode (When SelectedRequest == null) -->
                        <Border Grid.Row="0"
                                Visibility="{x:Bind ViewModel.SelectedRequest, Converter={StaticResource NullToVis}, Mode=OneWay}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        Width="38" Height="38"
                                        CornerRadius="19"
                                        Margin="0,0,12,0">
                                    <FontIcon Glyph="&#xE99A;" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="IT Support Virtual Assistant"
                                               FontWeight="SemiBold"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Automatic Ticket Generation &amp; Guided Triage"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <!-- Online Status Badge -->
                                <Border Grid.Column="2"
                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                        CornerRadius="12"
                                        Padding="10,4"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="#107C41" />
                                        <TextBlock Text="Online"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Foreground="#107C41" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Chat Header: Ticket Mode (When SelectedRequest != null) -->
                        <Border Grid.Row="0"
                                Visibility="{x:Bind ViewModel.SelectedRequest, Converter={StaticResource NotNullToVis}, Mode=OneWay}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        Width="38" Height="38"
                                        CornerRadius="19"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8BD;" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedRequest.DepartmentTitle, Mode=OneWay}"
                                               FontWeight="SemiBold"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedRequest.IdString, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="•" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedRequest.CreatedAtFormatted, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="•" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedRequest.AssignedAgent.DisplayName, Mode=OneWay}"
                                                   Visibility="{x:Bind ViewModel.SelectedRequest.AssignedAgent, Converter={StaticResource NotNullToVis}, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                   FontWeight="Medium" />
                                        <TextBlock Text="Unassigned (In Pool)"
                                                   Visibility="{x:Bind ViewModel.SelectedRequest.AssignedAgent, Converter={StaticResource NullToVis}, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   FontStyle="Italic" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Status Badge, Close Ticket & New Chat Actions -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="6"
                                            Padding="10,4">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedRequest.StatusName, Mode=OneWay}"
                                                   Foreground="White"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                    </Border>

                                    <Button Content="Close Ticket"
                                            Command="{x:Bind ViewModel.CloseComplaintCommand}"
                                            Visibility="{x:Bind ViewModel.SelectedRequest.CanBeClosed, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                                            Padding="10,5"
                                            FontSize="12" />

                                    <Button Command="{x:Bind ViewModel.StartNewChatCommand}"
                                            ToolTipService.ToolTip="Start a new complaint / triage chat"
                                            Padding="10,5"
                                            FontSize="12">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                                            <TextBlock Text="New Chat" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Chat Message Stream -->
                        <ListView Grid.Row="1"
                                  x:Name="ChatMessagesList"
                                  ItemsSource="{x:Bind ViewModel.ChatMessages, Mode=OneWay}"
                                  SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ChatMessageModel">
                                    <Grid Margin="0,6"
                                          HorizontalAlignment="{x:Bind Alignment}">
                                        <!-- SYSTEM EVENT BANNER (Pill design, Centered) -->
                                        <Border Visibility="{x:Bind IsSystemEvent, Converter={StaticResource BoolToVis}}"
                                                Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                Padding="14,6"
                                                Margin="0,4"
                                                HorizontalAlignment="Center">
                                            <TextBlock Text="{x:Bind Content}"
                                                       FontSize="12"
                                                       FontWeight="Medium"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       HorizontalAlignment="Center" />
                                        </Border>

                                        <!-- NORMAL CHAT BUBBLE & TICKET CARD -->
                                        <StackPanel Visibility="{x:Bind IsSystemEvent, Converter={StaticResource InverseBoolToVis}}"
                                                    MaxWidth="580" Spacing="6">
                                            <Border Background="{x:Bind Sender, Converter={StaticResource SenderToBackground}}"
                                                    CornerRadius="{x:Bind Sender, Converter={StaticResource SenderToCornerRadius}}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Padding="14,10">
                                                <StackPanel Spacing="4">
                                                    <!-- Sender Tag -->
                                                    <TextBlock Text="{x:Bind SenderName}"
                                                               FontWeight="SemiBold"
                                                               FontSize="11"
                                                               Foreground="{x:Bind Sender, Converter={StaticResource SenderToForeground}}"
                                                               Opacity="0.8" />

                                                    <!-- Screenshot Image Thumbnail (if attached) -->
                                                    <Border Visibility="{x:Bind HasImage, Converter={StaticResource BoolToVis}}"
                                                            CornerRadius="6"
                                                            MaxWidth="420"
                                                            MaxHeight="260"
                                                            Margin="0,2,0,4">
                                                        <Image Source="{x:Bind ImageBitmap}"
                                                               Stretch="Uniform"
                                                               HorizontalAlignment="Center" />
                                                    </Border>

                                                    <!-- Message Text -->
                                                    <TextBlock Visibility="{x:Bind HasText, Converter={StaticResource BoolToVis}}"
                                                               Text="{x:Bind Content}"
                                                               Foreground="{x:Bind Sender, Converter={StaticResource SenderToForeground}}"
                                                               TextWrapping="Wrap"
                                                               FontSize="14"
                                                               LineHeight="20" />

                                                    <!-- Timestamp -->
                                                    <TextBlock Text="{x:Bind FormattedTime}"
                                                               FontSize="10"
                                                               Foreground="{x:Bind Sender, Converter={StaticResource SenderToForeground}}"
                                                               Opacity="0.6"
                                                               HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Ticket Generated Card (Displayed if ticket created) -->
                                            <Border Visibility="{x:Bind IsTicketCard, Converter={StaticResource BoolToVis}}"
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="#107C41"
                                                    BorderThickness="2"
                                                    CornerRadius="8"
                                                    Padding="14"
                                                    Margin="0,4,0,0">
                                                <Grid RowSpacing="6">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE73E;" Foreground="#107C41" />
                                                        <TextBlock Text="Support Ticket Generated"
                                                                   FontWeight="Bold"
                                                                   Foreground="#107C41" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Row="1"
                                                               Text="{x:Bind CreatedTicketSubject}"
                                                               FontWeight="SemiBold"
                                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                                               TextWrapping="Wrap" />

                                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                                        <Border Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                                                                CornerRadius="4" Padding="6,2">
                                                            <TextBlock Text="{x:Bind CreatedTicketStatus}"
                                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                                       FontWeight="SemiBold" />
                                                        </Border>
                                                        <TextBlock Text="Dispatched to Customer Service Agent pool"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Quick Reply Suggestion Chips -->
                                            <ItemsControl ItemsSource="{x:Bind QuickReplies}"
                                                          Visibility="{x:Bind HasQuickReplies, Converter={StaticResource BoolToVis}}"
                                                          Margin="0,4,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="8" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Button Content="{x:Bind}"
                                                                Tag="{x:Bind}"
                                                                Click="QuickReplyButton_Click"
                                                                CornerRadius="16"
                                                                Padding="12,5"
                                                                FontSize="12"
                                                                FontWeight="Medium" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Typing / Processing Indicator -->
                        <StackPanel Grid.Row="2" Spacing="6" Margin="8,0">
                            <!-- Bot Processing Indicator -->
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        Visibility="{x:Bind ViewModel.IsBotProcessing, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                                <ProgressRing IsActive="True" Width="16" Height="16" />
                                <TextBlock Text="Support Assistant is processing your request..."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <!-- Agent Typing Indicator -->
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        Visibility="{x:Bind ViewModel.IsAgentTyping, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                                <ProgressRing IsActive="True" Width="14" Height="14" />
                                <TextBlock Text="{x:Bind ViewModel.AgentTypingNotification, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                           FontStyle="Italic" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Chat Input Bar -->
                        <Grid Grid.Row="3" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     x:Name="ChatInputBox"
                                     PlaceholderText="Type your problem or message here... (e.g. 'Software not working')"
                                     Text="{x:Bind ViewModel.ChatInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="ChatInputBox_KeyDown"
                                     TextChanged="ChatInputBox_TextChanged"
                                     CornerRadius="8"
                                     Padding="12,8" />

                            <!-- Attach Screenshot Button with Flyout -->
                            <Button Grid.Column="1"
                                    ToolTipService.ToolTip="Attach error screenshot">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Choose Image File..." Click="AttachTriageScreenshot_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xEB9F;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Paste from Clipboard" Click="PasteTriageScreenshot_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE77F;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE723;" FontSize="14" />
                                    <TextBlock Text="Attach" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.SendChatMessageCommand}"
                                    CornerRadius="8"
                                    Padding="16,8"
                                    ToolTipService.ToolTip="Send message (or press Enter)">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE724;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                    <TextBlock Text="Send" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>

                    <!-- VIEW 2: Ticket Details View (Active when IsTicketDetailsMode is true) -->
                    <Grid Visibility="{x:Bind ViewModel.IsTicketDetailsMode, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                        <ScrollViewer Visibility="{x:Bind ViewModel.SelectedRequest, Converter={StaticResource NotNullToVis}, Mode=OneWay}">
                            <StackPanel Spacing="20">
                                <!-- Back to Live Chat button -->
                                <Button Command="{x:Bind ViewModel.ReturnToChatCommand}"
                                        HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Back" />
                                        <TextBlock Text="Back to Support Assistant Chat" FontWeight="Medium" />
                                    </StackPanel>
                                </Button>

                                <!-- Ticket Header -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedRequest.DepartmentTitle, Mode=OneWay}"
                                                   Style="{StaticResource TitleTextBlockStyle}"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedRequest.IdString, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>

                                    <!-- Status Badge & Close Button -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Top">
                                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="6"
                                                Padding="10,4">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedRequest.StatusName, Mode=OneWay}"
                                                       Foreground="White"
                                                       FontWeight="SemiBold" />
                                        </Border>

                                        <Button Content="Close Ticket"
                                                Command="{x:Bind ViewModel.CloseComplaintCommand}"
                                                IsEnabled="{x:Bind ViewModel.SelectedRequest.CanBeClosed, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Problem Summary Section (Clean summary, no raw chat dump) -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="16">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Reported Problem Overview"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedRequest.SummaryText, Mode=OneWay}"
                                                   TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="True"
                                                   Style="{StaticResource BodyTextBlockStyle}" />

                                        <!-- Attachment Link & Image Preview (Visible if customer attached screenshot) -->
                                        <StackPanel Spacing="6"
                                                    Visibility="{x:Bind ViewModel.SelectedRequest.HasAttachment, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                                            <!-- Clickable File Attached Link -->
                                            <HyperlinkButton Command="{x:Bind ViewModel.OpenAttachmentCommand}"
                                                             CommandParameter="{x:Bind ViewModel.SelectedRequest.FullAttachmentUrl, Mode=OneWay}"
                                                             Padding="0">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE8A7;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    <TextBlock Text="File Attached (Click to open screenshot)"
                                                               FontWeight="SemiBold"
                                                               TextDecorations="Underline" />
                                                </StackPanel>
                                            </HyperlinkButton>

                                            <!-- Inline Image Thumbnail Preview -->
                                            <Border CornerRadius="6"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    MaxWidth="440"
                                                    MaxHeight="260"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,4,0,0">
                                                <Button Command="{x:Bind ViewModel.OpenAttachmentCommand}"
                                                        CommandParameter="{x:Bind ViewModel.SelectedRequest.FullAttachmentUrl, Mode=OneWay}"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        ToolTipService.ToolTip="Click to open full screenshot in viewer">
                                                    <Image Source="{x:Bind ViewModel.SelectedRequest.FullAttachmentUrl, Converter={StaticResource StringToImageSource}, Mode=OneWay}"
                                                           Stretch="Uniform"
                                                           MaxHeight="260" />
                                                </Button>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Assigned Customer Service Agent Section -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="16">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Assigned Customer Service Agent"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   FontWeight="SemiBold" />

                                        <!-- If assigned -->
                                        <StackPanel Visibility="{x:Bind ViewModel.SelectedRequest.AssignedAgent, Converter={StaticResource NotNullToVis}, Mode=OneWay}"
                                                    Orientation="Horizontal"
                                                    Spacing="12">
                                            <PersonPicture DisplayName="{x:Bind ViewModel.SelectedRequest.AssignedAgent.DisplayName, Mode=OneWay}"
                                                           Width="42" Height="42" />
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind ViewModel.SelectedRequest.AssignedAgent.DisplayName, Mode=OneWay}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedRequest.AssignedAgent.Department, Mode=OneWay}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- If not yet claimed -->
                                        <TextBlock Visibility="{x:Bind ViewModel.SelectedRequest.AssignedAgent, Converter={StaticResource NullToVis}, Mode=OneWay}"
                                                   Text="Awaiting an available support agent to claim this ticket from the pool."
                                                   FontStyle="Italic"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <!-- Dates Timeline Section -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="16">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Created Date -->
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="Created Date" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedRequest.CreatedAtFormatted, Mode=OneWay}" FontWeight="Medium" />
                                        </StackPanel>

                                        <!-- Closed Date -->
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Closed Date" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedRequest.ClosedAtFormatted, Mode=OneWay}"
                                                       Visibility="{x:Bind ViewModel.SelectedRequest.ClosedAt, Converter={StaticResource NotNullToVis}, Mode=OneWay}"
                                                       FontWeight="Medium" />
                                            <TextBlock Text="Active (Not Closed)"
                                                       Visibility="{x:Bind ViewModel.SelectedRequest.ClosedAt, Converter={StaticResource NullToVis}, Mode=OneWay}"
                                                       FontStyle="Italic"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <!-- Claimed Date -->
                                        <StackPanel Grid.Column="2" Spacing="4" Visibility="{x:Bind ViewModel.SelectedRequest.ClaimedAt, Converter={StaticResource NotNullToVis}, Mode=OneWay}">
                                            <TextBlock Text="Claimed Date" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedRequest.ClaimedAtFormatted, Mode=OneWay}" FontWeight="Medium" />
                                        </StackPanel>

                                        <!-- Resolved Date -->
                                        <StackPanel Grid.Column="3" Spacing="4" Visibility="{x:Bind ViewModel.SelectedRequest.ResolvedAt, Converter={StaticResource NotNullToVis}, Mode=OneWay}">
                                            <TextBlock Text="Resolved Date" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedRequest.ResolvedAtFormatted, Mode=OneWay}" FontWeight="Medium" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Live Support Chat with Customer Service Agent Section -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="8"
                                        Padding="16"
                                        Visibility="{x:Bind ViewModel.IsLiveChatActive, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                                    <Grid RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <!-- Chat Header -->
                                            <RowDefinition Height="Auto" />
                                            <!-- Live Chat Messages List -->
                                            <RowDefinition Height="300" />
                                            <!-- Agent Typing Indicator -->
                                            <RowDefinition Height="Auto" />
                                            <!-- Message Input & Screenshot Attach Bar -->
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Live Chat Header -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Ellipse Width="10" Height="10" Fill="#107C41" />
                                                <TextBlock Text="Live Real-Time Support Chat with Agent"
                                                           FontWeight="SemiBold"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="•" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedRequest.AssignedAgent.DisplayName, Mode=OneWay}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>

                                            <Border Grid.Column="1"
                                                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                    CornerRadius="10" Padding="8,2">
                                                <TextBlock Text="Agent Connected" FontSize="11" FontWeight="SemiBold" Foreground="#107C41" />
                                            </Border>
                                        </Grid>

                                        <!-- Live Messages List -->
                                        <ListView Grid.Row="1"
                                                  x:Name="LiveChatMessagesList"
                                                  ItemsSource="{x:Bind ViewModel.LiveChatMessages, Mode=OneWay}"
                                                  SelectionMode="None">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="models:ChatMessageModel">
                                                    <Grid Margin="0,4" HorizontalAlignment="{x:Bind IsMine, Converter={StaticResource IsMineToAlignment}}">
                                                        <StackPanel MaxWidth="520" Spacing="4">
                                                            <!-- Sender Tag -->
                                                            <TextBlock Text="{x:Bind SenderName}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="11"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                       HorizontalAlignment="{x:Bind IsMine, Converter={StaticResource IsMineToAlignment}}" />

                                                            <!-- Bubble -->
                                                            <Border Background="{x:Bind IsMine, Converter={StaticResource IsMineToBackground}}"
                                                                    CornerRadius="{x:Bind IsMine, Converter={StaticResource IsMineToCornerRadius}}"
                                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                    BorderThickness="1"
                                                                    Padding="12,8">
                                                                <StackPanel Spacing="6">
                                                                    <!-- Screenshot Image Thumbnail (if attached) -->
                                                                    <Border Visibility="{x:Bind HasImage, Converter={StaticResource BoolToVis}}"
                                                                            CornerRadius="6"
                                                                            MaxWidth="420"
                                                                            MaxHeight="260">
                                                                        <Image Source="{x:Bind ImageBitmap}"
                                                                               Stretch="Uniform"
                                                                               HorizontalAlignment="Center" />
                                                                    </Border>

                                                                    <!-- Text Content -->
                                                                    <TextBlock Visibility="{x:Bind HasText, Converter={StaticResource BoolToVis}}"
                                                                               Text="{x:Bind Content}"
                                                                               Foreground="{x:Bind IsMine, Converter={StaticResource IsMineToForeground}}"
                                                                               TextWrapping="Wrap"
                                                                               FontSize="13" />

                                                                    <!-- Time -->
                                                                    <TextBlock Text="{x:Bind FormattedTime}"
                                                                               FontSize="9"
                                                                               Foreground="{x:Bind IsMine, Converter={StaticResource IsMineToForeground}}"
                                                                               Opacity="0.65"
                                                                               HorizontalAlignment="Right" />
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>

                                        <!-- Agent Typing Indicator -->
                                        <StackPanel Grid.Row="2"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    Visibility="{x:Bind ViewModel.IsAgentTyping, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                                            <ProgressRing IsActive="True" Width="14" Height="14" />
                                            <TextBlock Text="{x:Bind ViewModel.AgentTypingNotification, Mode=OneWay}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                       FontStyle="Italic" />
                                        </StackPanel>

                                        <!-- Live Chat Input Bar -->
                                        <Grid Grid.Row="3" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBox Grid.Column="0"
                                                     x:Name="LiveChatInputBox"
                                                     PlaceholderText="Type a message to the agent... (Enter to send)"
                                                     Text="{x:Bind ViewModel.LiveChatInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     KeyDown="LiveChatInputBox_KeyDown"
                                                     TextChanged="LiveChatInputBox_TextChanged"
                                                     CornerRadius="6"
                                                     Padding="10,7" />

                                            <!-- Attach Screenshot Button with Flyout -->
                                            <Button Grid.Column="1"
                                                    ToolTipService.ToolTip="Attach error screenshot">
                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="Choose Image File..." Click="AttachLiveScreenshot_Click">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xEB9F;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Paste from Clipboard" Click="PasteLiveScreenshot_Click">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE77F;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE723;" FontSize="14" />
                                                    <TextBlock Text="Attach" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Send Message Button -->
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Command="{x:Bind ViewModel.SendLiveMessageCommand}"
                                                    CornerRadius="6"
                                                    Padding="14,7"
                                                    ToolTipService.ToolTip="Send live reply">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE724;" FontSize="13" />
                                                    <TextBlock Text="Send" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Notice when ticket is unassigned / live chat not yet active -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        Visibility="{x:Bind ViewModel.IsLiveChatActive, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon Glyph="&#xE8BD;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="Ticket Dispatched to Support Queue" FontWeight="SemiBold" />
                                            <TextBlock Text="Your ticket is currently waiting in the Customer Service pool. Once an agent claims your ticket, live real-time chat will automatically be enabled here."
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Chat History Action Button -->
                                <Button Command="{x:Bind ViewModel.ViewChatHistoryCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Padding="16,14"
                                        CornerRadius="8"
                                        Visibility="{x:Bind ViewModel.HasHistoryTranscript, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                                    <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE8BD;" FontSize="20" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="View Full Chat History" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Text="Click to replay your complete conversation with the Virtual Assistant" FontSize="12" Opacity="0.85" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- VIEW 3: Chat History Replay View (Active when IsChatHistoryMode is true) -->
                    <Grid Visibility="{x:Bind ViewModel.IsChatHistoryMode, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                          RowSpacing="14">
                        <Grid.RowDefinitions>
                            <!-- Header with Back Button -->
                            <RowDefinition Height="Auto" />
                            <!-- Historical Messages List -->
                            <RowDefinition Height="*" />
                            <!-- Footer Archive Banner -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header Bar -->
                        <Border Grid.Row="0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Command="{x:Bind ViewModel.CloseChatHistoryCommand}"
                                        Margin="0,0,12,0"
                                        Padding="8,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <SymbolIcon Symbol="Back" />
                                        <TextBlock Text="Back" />
                                    </StackPanel>
                                </Button>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.HistoryChatTitle, Mode=OneWay}"
                                               FontWeight="SemiBold"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind ViewModel.HistoryChatSubtitle, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <Border Grid.Column="2"
                                        Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                                        CornerRadius="12"
                                        Padding="10,4"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Archived Chat"
                                               FontWeight="SemiBold"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Chat Messages Stream (Replay) -->
                        <ListView Grid.Row="1"
                                  ItemsSource="{x:Bind ViewModel.HistoryChatMessages, Mode=OneWay}"
                                  SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ChatMessageModel">
                                    <Grid Margin="0,6"
                                          HorizontalAlignment="{x:Bind Alignment}">
                                        <StackPanel MaxWidth="580" Spacing="4">
                                            <Border Background="{x:Bind Sender, Converter={StaticResource SenderToBackground}}"
                                                    CornerRadius="{x:Bind Sender, Converter={StaticResource SenderToCornerRadius}}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Padding="14,10">
                                                <StackPanel Spacing="4">
                                                    <!-- Sender Tag -->
                                                    <TextBlock Text="{x:Bind SenderName}"
                                                               FontWeight="SemiBold"
                                                               FontSize="11"
                                                               Foreground="{x:Bind Sender, Converter={StaticResource SenderToForeground}}"
                                                               Opacity="0.8" />

                                                    <!-- Screenshot Image Thumbnail (if attached) -->
                                                    <Border Visibility="{x:Bind HasImage, Converter={StaticResource BoolToVis}}"
                                                            CornerRadius="6"
                                                            MaxWidth="420"
                                                            MaxHeight="260"
                                                            Margin="0,2,0,4">
                                                        <Image Source="{x:Bind ImageBitmap}"
                                                               Stretch="Uniform"
                                                               HorizontalAlignment="Center" />
                                                    </Border>

                                                    <!-- Message Text -->
                                                    <TextBlock Text="{x:Bind Content}"
                                                               Foreground="{x:Bind Sender, Converter={StaticResource SenderToForeground}}"
                                                               TextWrapping="Wrap"
                                                               FontSize="14"
                                                               LineHeight="20" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Footer Banner -->
                        <Border Grid.Row="2"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,8">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE72E;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="This is a read-only archive of the conversation recorded when this ticket was filed."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </SplitView.Content>
    </SplitView>

        <!-- ROW 0,1,2 span: Active Directory Corporate Sign In Fullscreen Modal Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Background="#99000000"
              Visibility="{x:Bind ViewModel.IsLoginViewVisible, Converter={StaticResource BoolToVis}, Mode=OneWay}">
            <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="32"
                    Width="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                Width="48" Height="48"
                                CornerRadius="24"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,4">
                            <FontIcon Glyph="&#xE99A;" Foreground="White" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Corporate Domain Sign In"
                                   Style="{StaticResource TitleTextBlockStyle}"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Active Directory Authentication for Customer Support Portal"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <InfoBar IsOpen="{x:Bind ViewModel.LoginErrorMessage, Converter={StaticResource StringNotEmptyToBool}, Mode=OneWay}"
                             Severity="Error"
                             Title="Authentication Error"
                             Message="{x:Bind ViewModel.LoginErrorMessage, Mode=OneWay}" />

                    <StackPanel Spacing="12">
                        <TextBox Header="Domain Username"
                                 PlaceholderText="e.g. TIH\user.john"
                                 Text="{x:Bind ViewModel.LoginUsername, Mode=TwoWay}"
                                 CornerRadius="6" />

                        <PasswordBox Header="Password"
                                     PlaceholderText="Enter corporate password"
                                     PasswordChanged="PasswordBox_PasswordChanged"
                                     KeyDown="LoginPasswordBox_KeyDown"
                                     CornerRadius="6" />
                    </StackPanel>

                    <StackPanel Spacing="10" Margin="0,6,0,0">
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.SignInCommand}"
                                HorizontalAlignment="Stretch"
                                Padding="12,10"
                                CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsLoggingIn, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.IsLoggingIn, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                                              Width="16" Height="16" />
                                <TextBlock Text="Sign In to Customer Desk" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button Content="Cancel"
                                Command="{x:Bind ViewModel.CancelLoginCommand}"
                                HorizontalAlignment="Stretch"
                                Visibility="{x:Bind ViewModel.CurrentUserDisplayName, Converter={StaticResource NotNullToVis}, Mode=OneWay}" />
                    </StackPanel>

                    <TextBlock Text="Simulated Active Directory accounts: TIH\user.john, TIH\user.mary (Password: Password123!)"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

