<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CustomerSupport_CsDesktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CustomerSupport_CsDesktop"
    xmlns:models="using:CustomerSupport_CsDesktop.Models"
    xmlns:dtos="using:CustomerSupport.Application.Dtos"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
        <local:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <local:NullToVisibilityConverter x:Key="NotNullToVis" Invert="False" />
        <local:NullToVisibilityConverter x:Key="NullToVis" Invert="True" />
        <local:StringNotNullOrEmptyToBoolConverter x:Key="StringNotEmptyToBool" />
        <local:ChatSenderToAlignmentConverter x:Key="SenderToAlignment" />
        <local:ChatSenderToBackgroundConverter x:Key="SenderToBackground" />
        <local:ChatSenderToForegroundConverter x:Key="SenderToForeground" />
        <local:ChatSenderToCornerRadiusConverter x:Key="SenderToCornerRadius" />
        <local:IsMineToAlignmentConverter x:Key="IsMineToAlignment" />
        <local:IsMineToBackgroundConverter x:Key="IsMineToBackground" />
        <local:IsMineToForegroundConverter x:Key="IsMineToForeground" />
        <local:IsMineToCornerRadiusConverter x:Key="IsMineToCornerRadius" />
        <local:StringToImageSourceConverter x:Key="StringToImageSource" />
    </Page.Resources>

    <Grid Padding="24,16,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <!-- 0: Header Banner & Agent Profile / Switcher -->
            <RowDefinition Height="Auto" />
            <!-- 1: Notification & Conflict Banners -->
            <RowDefinition Height="Auto" />
            <!-- 2: Master-Detail Work Area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ROW 0: Header Banner & Agent Profile / Switcher -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Hamburger Sidebar Toggle Button -->
            <Button Grid.Column="0"
                    Command="{x:Bind ViewModel.ToggleSidebarCommand}"
                    ToolTipService.ToolTip="Toggle Queues Panel"
                    VerticalAlignment="Center"
                    Padding="8"
                    CornerRadius="6"
                    Background="Transparent"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <FontIcon Glyph="&#xE700;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" />
            </Button>

            <!-- App Title & Branding -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE7EF;" FontSize="24" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock Text="Support Agent Console"
                               Style="{StaticResource TitleLargeTextBlockStyle}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Text="Enterprise Queue Triage, Multi-Agent Concurrency &amp; Ticket Resolution"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Dev Switcher & Agent Profile -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                <!-- Dev Agent Switcher Dropdown (for simultaneous multi-agent testing) -->
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Simulate Agent:"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="AgentSwitcherBox"
                              ItemsSource="{x:Bind ViewModel.AvailableDevAgents}"
                              SelectedItem="{x:Bind ViewModel.SelectedDevAgent, Mode=TwoWay}"
                              SelectionChanged="AgentSwitcher_SelectionChanged"
                              Width="180" />
                </StackPanel>

                <!-- Agent Profile Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <PersonPicture DisplayName="{x:Bind ViewModel.CurrentAgentDisplayName, Mode=OneWay}" Width="34" Height="34" />
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{x:Bind ViewModel.CurrentAgentDisplayName, Mode=OneWay}"
                                       FontWeight="Medium"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="4" Padding="4,1">
                                    <TextBlock Text="{x:Bind ViewModel.CurrentAgentRole, Mode=OneWay}"
                                               FontSize="10"
                                               Foreground="White"
                                               FontWeight="SemiBold" />
                                </Border>
                                <TextBlock Text="{x:Bind ViewModel.CurrentAgentDepartment, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Refresh Button -->
                <Button Command="{x:Bind ViewModel.RefreshQueuesCommand}"
                        ToolTipService.ToolTip="Refresh All Ticket Queues">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Refresh" />
                        <TextBlock Text="Refresh Queues" />
                    </StackPanel>
                </Button>

                <!-- Sign Out Button -->
                <Button Command="{x:Bind ViewModel.SignOutCommand}"
                        ToolTipService.ToolTip="Sign out of current account">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7E8;" FontSize="14" />
                        <TextBlock Text="Sign Out" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ROW 1: Progress, Error, & Concurrency Conflict Banners -->
        <StackPanel Grid.Row="1" Spacing="8">
            <ProgressBar IsIndeterminate="True"
                         Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                         HorizontalAlignment="Stretch" />

            <!-- Optimistic Concurrency 409 Conflict InfoBar -->
            <InfoBar IsOpen="{x:Bind ViewModel.ConflictMessage, Converter={StaticResource StringNotEmptyToBool}, Mode=OneWay}"
                     Severity="Warning"
                     Title="Claim Collision / Concurrency Conflict"
                     Message="{x:Bind ViewModel.ConflictMessage, Mode=OneWay}" />

            <!-- Error InfoBar -->
            <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Converter={StaticResource StringNotEmptyToBool}, Mode=OneWay}"
                     Severity="Error"
                     Title="Error"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
        </StackPanel>

        <!-- ROW 2: Master-Detail Work Area (SplitView with Sliding Drawer) -->
        <SplitView Grid.Row="2"
                   IsPaneOpen="{x:Bind ViewModel.IsSidebarOpen, Mode=TwoWay}"
                   DisplayMode="Inline"
                   OpenPaneLength="430"
                   CompactPaneLength="0"
                   PaneBackground="Transparent">
            <!-- PANE: Multi-Queue Triage Panel (Master) -->
            <SplitView.Pane>
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <!-- Queue Selector Tabs -->
                        <RowDefinition Height="Auto" />
                        <!-- Tickets ListView -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Queue Segmented Tabs -->
                    <StackPanel Grid.Row="0" Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Tab 0: Unassigned Pool -->
                            <Button Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    Click="QueueTab0_Click"
                                    Padding="6,8">
                                <StackPanel HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Unassigned" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                            CornerRadius="10" Padding="8,1" HorizontalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.UnassignedCount, Mode=OneWay}" FontSize="11" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <!-- Tab 1: My Active Tickets -->
                            <Button Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    Click="QueueTab1_Click"
                                    Padding="6,8">
                                <StackPanel HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="My Active" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="10" Padding="8,1" HorizontalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.MyAssignedCount, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <!-- Tab 2: All Tickets -->
                            <Button Grid.Column="2"
                                    HorizontalAlignment="Stretch"
                                    Click="QueueTab2_Click"
                                    Padding="6,8">
                                <StackPanel HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="All Tickets" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <Border Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                                            CornerRadius="10" Padding="8,1" HorizontalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.AllCount, Mode=OneWay}" FontSize="11" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Tickets ListView -->
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.DisplayedRequests, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedRequest, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="dtos:SupportRequestDto">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Stretch">
                                    <Grid RowSpacing="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Subject, Unread Count Badge & Priority -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{x:Bind DepartmentTitle}"
                                                       FontWeight="SemiBold"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="1"
                                                       VerticalAlignment="Center" />

                                            <!-- WhatsApp Style Unread Count Badge -->
                                            <Border Grid.Column="1"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="10"
                                                    MinWidth="20"
                                                    Height="20"
                                                    Padding="6,1"
                                                    Margin="6,0,0,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Visibility="{x:Bind HasUnreadMessages, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{x:Bind UnreadCount, Mode=OneWay}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <Border Grid.Column="2"
                                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                    CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind PriorityName}" FontSize="11" FontWeight="Bold" />
                                            </Border>
                                        </Grid>

                                        <!-- Requester Info & Summary -->
                                        <StackPanel Grid.Row="1" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE77B;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind Requester.DisplayName}" FontSize="12" FontWeight="Medium" />
                                                <TextBlock Text="•" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{x:Bind Requester.Department}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind SummaryText}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="2" />
                                        </StackPanel>

                                        <!-- Badges & Timestamps -->
                                        <Grid Grid.Row="2" Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                                <Border Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                                                        CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{x:Bind StatusName}" FontSize="11" FontWeight="SemiBold" />
                                                </Border>

                                                <!-- If assigned, show who -->
                                                <Border Visibility="{x:Bind AssignedAgent, Converter={StaticResource NotNullToVis}}"
                                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{x:Bind AssignedAgent.DisplayName}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind CreatedAtFormatted}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </SplitView.Pane>

            <!-- RIGHT COLUMN: Detail / Action Workspace -->
            <SplitView.Content>
                <Border
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24">
                <Grid>
                    <!-- VIEW A: Dedicated Full-Height Live Support Chat Workspace (When ticket is selected) -->
                    <Grid Visibility="{x:Bind ViewModel.IsViewingChatHistory, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}">
                        <!-- 1. Active Ticket Chat View (when SelectedRequest != null) -->
                        <Grid Visibility="{x:Bind ViewModel.SelectedRequest, Converter={StaticResource NotNullToVis}, Mode=OneWay}"
                              RowSpacing="12">
                            <Grid.RowDefinitions>
                                <!-- 0: Top Action & Requester Header Bar -->
                                <RowDefinition Height="Auto" />
                                <!-- 1: Full-Height Chat Stream (Intake Chat + Live Chat) -->
                                <RowDefinition Height="*" />
                                <!-- 2: Customer Typing Indicator -->
                                <RowDefinition Height="Auto" />
                                <!-- 3: Input / Action Bar -->
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- ROW 0: Top Action & Requester Header Bar -->
                            <Border Grid.Row="0"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16,12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Customer Avatar -->
                                    <PersonPicture Grid.Column="0"
                                                   DisplayName="{x:Bind ViewModel.SelectedRequest.Requester.DisplayName, Mode=OneWay}"
                                                   Width="44" Height="44"
                                                   VerticalAlignment="Center" />

                                    <!-- Subject, Requester Details & Meta -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedRequest.DepartmentTitle, Mode=OneWay}"
                                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                                   FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis" />

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedRequest.Requester.DisplayName, Mode=OneWay}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12" />
                                            <TextBlock Text="•" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedRequest.Requester.DomainUsername, Mode=OneWay}"
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="•" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedRequest.IdString, Mode=OneWay}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="•" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedRequest.CreatedAtFormatted, Mode=OneWay}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Status, Priority & Claim/Resolve Action Buttons -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                CornerRadius="4" Padding="8,3">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedRequest.PriorityName, Mode=OneWay}"
                                                       FontSize="11" FontWeight="Bold" />
                                        </Border>

                                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="6" Padding="10,4">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedRequest.StatusName, Mode=OneWay}"
                                                       Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                        </Border>

                                        <!-- Claim Button (Enabled when ticket is unassigned) -->
                                        <Button Style="{StaticResource AccentButtonStyle}"
                                                Command="{x:Bind ViewModel.ClaimTicketCommand}"
                                                Visibility="{x:Bind ViewModel.CanClaim, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                                                Padding="12,6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8D7;" FontSize="14" />
                                                <TextBlock Text="Claim Ticket" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Mark as Resolved Button (Enabled when InProgress and assigned to me) -->
                                        <Button Command="{x:Bind ViewModel.ResolveTicketCommand}"
                                                Visibility="{x:Bind ViewModel.CanResolve, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                                                Padding="12,6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="#107C41" />
                                                <TextBlock Text="Resolve Ticket" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Close Ticket Button -->
                                        <Button Content="Close Ticket"
                                                Command="{x:Bind ViewModel.CloseTicketCommand}"
                                                Visibility="{x:Bind ViewModel.CanClose, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                                                Padding="12,6" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ROW 1: Full-Height Chat Stream (Intake Dialogue + System Event + Live Chat) -->
                            <ListView Grid.Row="1"
                                      x:Name="LiveChatMessagesList"
                                      ItemsSource="{x:Bind ViewModel.LiveChatMessages, Mode=OneWay}"
                                      SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ChatMessageModel">
                                        <Grid Margin="0,5" HorizontalAlignment="{x:Bind Alignment}">
                                            <!-- SYSTEM EVENT BANNER (Centered Pill) -->
                                            <Border Visibility="{x:Bind IsSystemEvent, Converter={StaticResource BoolToVis}}"
                                                    Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="14"
                                                    Padding="16,6"
                                                    Margin="0,4"
                                                    HorizontalAlignment="Center">
                                                <TextBlock Text="{x:Bind Content}"
                                                           FontSize="12"
                                                           FontWeight="Medium"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           HorizontalAlignment="Center" />
                                            </Border>

                                            <!-- NORMAL CHAT BUBBLE (Agent = Right/Accent; Customer/Bot = Left/Card) -->
                                            <StackPanel Visibility="{x:Bind IsSystemEvent, Converter={StaticResource InverseBoolToVis}}"
                                                        MaxWidth="600" Spacing="4">
                                                <!-- Sender Tag -->
                                                <TextBlock Text="{x:Bind SenderName}"
                                                           FontWeight="SemiBold"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           HorizontalAlignment="{x:Bind IsMine, Converter={StaticResource IsMineToAlignment}}" />

                                                <!-- Bubble Container -->
                                                <Border Background="{x:Bind IsMine, Converter={StaticResource IsMineToBackground}}"
                                                        CornerRadius="{x:Bind IsMine, Converter={StaticResource IsMineToCornerRadius}}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        Padding="14,10">
                                                    <StackPanel Spacing="6">
                                                        <!-- Screenshot Image Thumbnail (if attached) -->
                                                        <Border Visibility="{x:Bind HasImage, Converter={StaticResource BoolToVis}}"
                                                                CornerRadius="6"
                                                                MaxWidth="440"
                                                                MaxHeight="280">
                                                            <Image Source="{x:Bind ImageBitmap}"
                                                                   Stretch="Uniform"
                                                                   HorizontalAlignment="Center" />
                                                        </Border>

                                                        <!-- Message Text -->
                                                        <TextBlock Visibility="{x:Bind HasText, Converter={StaticResource BoolToVis}}"
                                                                   Text="{x:Bind Content}"
                                                                   Foreground="{x:Bind IsMine, Converter={StaticResource IsMineToForeground}}"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="13.5"
                                                                   LineHeight="19" />

                                                        <!-- Timestamp -->
                                                        <TextBlock Text="{x:Bind FormattedTime}"
                                                                   FontSize="10"
                                                                   Foreground="{x:Bind IsMine, Converter={StaticResource IsMineToForeground}}"
                                                                   Opacity="0.65"
                                                                   HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- ROW 2: Customer Typing Indicator -->
                            <StackPanel Grid.Row="2"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Visibility="{x:Bind ViewModel.IsCustomerTyping, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                                        Margin="8,0">
                                <ProgressRing IsActive="True" Width="14" Height="14" />
                                <TextBlock Text="{x:Bind ViewModel.CustomerTypingNotification, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                           FontStyle="Italic" />
                            </StackPanel>

                            <!-- ROW 3: Input / Action Bar -->
                            <Grid Grid.Row="3">
                                <!-- 3A: When Ticket is Claimed & Active: Rich Chat Input Bar -->
                                <Grid Visibility="{x:Bind ViewModel.IsLiveChatActive, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                                      ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"
                                             x:Name="LiveChatInputBox"
                                             PlaceholderText="Type a live reply to the customer... (Enter to send)"
                                             Text="{x:Bind ViewModel.LiveChatInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             KeyDown="LiveChatInputBox_KeyDown"
                                             TextChanged="LiveChatInputBox_TextChanged"
                                             CornerRadius="8"
                                             Padding="12,8" />

                                    <!-- Attach Screenshot Button with Flyout -->
                                    <Button Grid.Column="1"
                                            ToolTipService.ToolTip="Attach error screenshot or diagram">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Choose Image File..." Click="AttachScreenshotButton_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xEB9F;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Paste from Clipboard" Click="PasteScreenshotButton_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE77F;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE723;" FontSize="14" />
                                            <TextBlock Text="Attach" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Send Message Button -->
                                    <Button Grid.Column="2"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Command="{x:Bind ViewModel.SendLiveMessageCommand}"
                                            CornerRadius="8"
                                            Padding="16,8"
                                            ToolTipService.ToolTip="Send live reply to customer">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE724;" FontSize="13" />
                                            <TextBlock Text="Send" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- 3B: When Ticket is Unassigned in Pool: Prominent Claim Banner -->
                                <Border Visibility="{x:Bind ViewModel.CanClaim, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8BD;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="This ticket is unassigned. Claim it to begin live real-time chat with the customer."
                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Command="{x:Bind ViewModel.ClaimTicketCommand}"
                                                Padding="16,8"
                                                CornerRadius="6">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE8D7;" FontSize="15" />
                                                <TextBlock Text="Claim Ticket &amp; Start Chat" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- 3C: When Ticket is Resolved or Closed: Read-only banner -->
                                <Border Visibility="{x:Bind ViewModel.IsTicketClosedOrResolved, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,10">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE72E;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="This ticket has been concluded. Conversation history is saved and preserved in the audit log."
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- 2. Empty State View (When no ticket is selected) -->
                        <Grid Visibility="{x:Bind ViewModel.SelectedRequest, Converter={StaticResource NullToVis}, Mode=OneWay}"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Spacing="12" HorizontalAlignment="Center">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Width="64" Height="64"
                                        CornerRadius="32"
                                        HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE8BD;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Select a Support Ticket"
                                           Style="{StaticResource SubtitleTextBlockStyle}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Choose a ticket from the queue on the left to review the customer's problem intake and start live support."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           MaxWidth="360"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- VIEW B: Customer Chat History Replay (Active when IsViewingChatHistory is true) -->
                    <Grid Visibility="{x:Bind ViewModel.IsViewingChatHistory, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                          RowSpacing="14">
                        <Grid.RowDefinitions>
                            <!-- Header Bar with Back Button -->
                            <RowDefinition Height="Auto" />
                            <!-- Historical Messages List -->
                            <RowDefinition Height="*" />
                            <!-- Footer Archive Banner -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header Bar -->
                        <Border Grid.Row="0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Command="{x:Bind ViewModel.CloseCustomerChatHistoryCommand}"
                                        Margin="0,0,12,0"
                                        Padding="8,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <SymbolIcon Symbol="Back" />
                                        <TextBlock Text="Back to Ticket" />
                                    </StackPanel>
                                </Button>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.HistoryChatTitle, Mode=OneWay}"
                                               FontWeight="SemiBold"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind ViewModel.HistoryChatSubtitle, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <Border Grid.Column="2"
                                        Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                                        CornerRadius="12"
                                        Padding="10,4"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Customer Triage Transcript"
                                               FontWeight="SemiBold"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Messages Stream -->
                        <ListView Grid.Row="1"
                                  ItemsSource="{x:Bind ViewModel.HistoryChatMessages, Mode=OneWay}"
                                  SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ChatMessageModel">
                                    <Grid Margin="0,6"
                                          HorizontalAlignment="{x:Bind Alignment}">
                                        <StackPanel MaxWidth="580" Spacing="4">
                                            <Border Background="{x:Bind Sender, Converter={StaticResource SenderToBackground}}"
                                                    CornerRadius="{x:Bind Sender, Converter={StaticResource SenderToCornerRadius}}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Padding="14,10">
                                                <StackPanel Spacing="4">
                                                    <!-- Sender Tag -->
                                                    <TextBlock Text="{x:Bind SenderName}"
                                                               FontWeight="SemiBold"
                                                               FontSize="11"
                                                               Foreground="{x:Bind Sender, Converter={StaticResource SenderToForeground}}"
                                                               Opacity="0.8" />

                                                    <!-- Message Text -->
                                                    <TextBlock Text="{x:Bind Content}"
                                                               Foreground="{x:Bind Sender, Converter={StaticResource SenderToForeground}}"
                                                               TextWrapping="Wrap"
                                                               FontSize="14"
                                                               LineHeight="20" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Footer Banner -->
                        <Border Grid.Row="2"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,8">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE72E;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="This dialogue was recorded during initial customer triage and is stored as an immutable audit record."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </SplitView.Content>
    </SplitView>

        <!-- ROW 0,1,2 span: Active Directory Corporate Sign In Fullscreen Modal Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Background="#99000000"
              Visibility="{x:Bind ViewModel.IsLoginViewVisible, Converter={StaticResource BoolToVis}, Mode=OneWay}">
            <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="32"
                    Width="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                Width="48" Height="48"
                                CornerRadius="24"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,4">
                            <FontIcon Glyph="&#xE7EF;" Foreground="White" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Corporate Domain Sign In"
                                   Style="{StaticResource TitleTextBlockStyle}"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Active Directory Authentication for Support Agent Console"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <InfoBar IsOpen="{x:Bind ViewModel.LoginErrorMessage, Converter={StaticResource StringNotEmptyToBool}, Mode=OneWay}"
                             Severity="Error"
                             Title="Authentication Error"
                             Message="{x:Bind ViewModel.LoginErrorMessage, Mode=OneWay}" />

                    <StackPanel Spacing="12">
                        <TextBox Header="Domain Username"
                                 PlaceholderText="e.g. TIH\agent.sara"
                                 Text="{x:Bind ViewModel.LoginUsername, Mode=TwoWay}"
                                 CornerRadius="6" />

                        <PasswordBox Header="Password"
                                     PlaceholderText="Enter corporate password"
                                     PasswordChanged="PasswordBox_PasswordChanged"
                                     KeyDown="LoginPasswordBox_KeyDown"
                                     CornerRadius="6" />
                    </StackPanel>

                    <StackPanel Spacing="10" Margin="0,6,0,0">
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.SignInCommand}"
                                HorizontalAlignment="Stretch"
                                Padding="12,10"
                                CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsLoggingIn, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.IsLoggingIn, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                                              Width="16" Height="16" />
                                <TextBlock Text="Sign In to CS Console" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button Content="Cancel"
                                Command="{x:Bind ViewModel.CancelLoginCommand}"
                                HorizontalAlignment="Stretch"
                                Visibility="{x:Bind ViewModel.IsAuthorizedAgent, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                    </StackPanel>

                    <TextBlock Text="Simulated Active Directory: TIH\agent.sara, TIH\agent.ali, TIH\admin.user (Password: Password123!)"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

